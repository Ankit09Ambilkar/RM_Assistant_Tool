# Supabase Postgres connection. Leave empty to use the local SQLite file (backend/mindsparks.db).
# Use the SESSION POOLER string (works on IPv4 networks), from Supabase → Connect → Connection string → Session pooler:
#   postgresql://postgres.fkmpasdkasxkdqesgtef:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# If your password has special characters, percent-encode them (@ → %40, # → %23, / → %2F, : → %3A, ? → %3F, % → %25).
DATABASE_URL=

# Supabase Auth (server only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Comma-separated admin emails (can open /admin)
ADMIN_EMAILS=
